[Unit]
Description=Bayanko Uptime checker and notification worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uptime
Group=uptime
WorkingDirectory=/opt/uptime/current
Environment=NODE_ENV=production
Environment=PATH=/opt/uptime/runtime/node/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=128
ExecStart=/opt/uptime/runtime/node/bin/node --import tsx src/worker.ts
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
